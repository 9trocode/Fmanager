# Founder Finance — environment

# REQUIRED for any non-local deploy. If unset, auth is disabled (anyone can log in).
ADMIN_PASSWORD=

# Optional second password for read-only access (sharing the dashboard with spouse / co-founder).
# When unset, viewer access is disabled.
VIEWER_PASSWORD=

# Used to sign session cookies. Defaults to ADMIN_PASSWORD if unset; set explicitly in prod.
SESSION_SECRET=

# SQLite path. Default ./data/app.db
# DATABASE_URL=./data/app.db

# Optional: fallback Anthropic key for the AI advisor.
# You can also set this in Settings → Advisor at runtime.
ANTHROPIC_API_KEY=

# Optional: only used to construct absolute redirect URLs in API routes.
APP_URL=http://localhost:3000
